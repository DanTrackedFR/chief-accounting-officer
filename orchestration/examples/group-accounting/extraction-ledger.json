    "source_id": "appraisal",
    "value": "Asset LAND-1. Independent acquisition-date incremental land fair value USD100, supported by an approved valuation report. No depreciable FV uplift. Acquired cash USD900 and debt USD200. Independently valued non-controlling 20% equity interest fair value USD200."
  },
  {
    "extracted_fingerprint": "1ff54e4086242e17dbf7f51a248d63f33cc49bec1b126ce217b54220e3db1ec0",
    "id": "policy:1",
