    "source_fingerprint": "1aac853eceaf8d1ac650336c445d1c139b92a9040da5a85d5173306e6acc8759",
    "source_id": "spa",
    "value": "Signed completion 1 July 2026. Ordinary operating business acquired by Parent. Transferred experienced operating team, service-delivery systems and substantive documented processes with recurring customer outputs. 80% voting rights; substantive board appointment and operating decision rights; no participating rights held by minority. Price USD800; independent NCI fair value USD200. No earnout, prior interest or ownership change."
  },
  {
    "extracted_fingerprint": "f4bb1d14b492097472d06a9da6f39be3bcf4900b559b7656e0a972ec2d4092ea",
    "id": "appraisal:1",
