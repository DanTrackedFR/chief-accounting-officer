{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standards claim evidence",
  "type": "object",
  "required": [
    "topic_id",
    "claims"
  ],
  "properties": {
    "topic_id": {
      "type": "string",
      "pattern": "^TOPIC-[0-9]{2}-[0-9]{3}$"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "framework",
          "proposition",
          "evidence_status",
          "sources",
          "audit_required"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "framework": {
            "enum": [
              "IFRS",
              "US_GAAP",
              "UK_GAAP",
              "AASB",
              "SEC",
              "REGULATORY",
              "OTHER"
            ]
          },
          "proposition": {
            "type": "string",
            "minLength": 1
          },
          "paragraph_references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reference_confidence": {
            "enum": [
              "VERIFIED",
              "PROVISIONAL",
              "UNKNOWN"
            ]
          },
          "evidence_status": {
            "enum": [
              "SOURCE_VERIFIED",
              "PRIMARY_CORROBORATED",
              "SECONDARY_CORROBORATED",
              "MODEL_DERIVED_AUDIT_REQUIRED",
              "CONFLICTED",
              "NOT_RESEARCHED"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_kind",
                "title"
              ],
              "properties": {
                "source_kind": {
                  "enum": [
                    "CURRENT_STANDARD",
                    "OFFICIAL_AMENDMENT",
                    "REGULATOR",
                    "OFFICIAL_TAXONOMY",
                    "PROFESSIONAL_LITERATURE",
                    "MODEL_KNOWLEDGE",
                    "OTHER"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "locator": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "version_date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "access_date": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "inspected": {
                  "type": "boolean"
                }
              }
            }
          },
          "effective_period": {
            "type": [
              "string",
              "null"
            ]
          },
          "entity_scope": {
            "type": [
              "string",
              "null"
            ]
          },
          "audit_required": {
            "type": "boolean"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model_reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "model": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "outcome": {
                  "type": "string"
                },
                "disagreements": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "reviewer": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Internal-only provenance note. Never expose to user-facing output."
          },
          "approval_track": {
            "enum": [
              "DIRECT_SOURCE_CHECKED",
              "TRAINING_DATA_CHECKED",
              "PENDING"
            ],
            "description": "Independent topic approval track; separate from authority evidence_status."
          },
          "approval_review": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "reviewer": {
                "type": "string"
              },
              "date": {
                "type": "string"
              },
              "result": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "PENDING"
                ]
              },
              "scope_and_period_checked": {
                "type": "boolean"
              },
              "cross_framework_checked": {
                "type": "boolean"
              },
              "regression_checked": {
                "type": "boolean"
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
