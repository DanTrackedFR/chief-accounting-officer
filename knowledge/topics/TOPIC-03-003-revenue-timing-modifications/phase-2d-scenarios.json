    {
      "id": "RT-integrated-modification-catchdown",
      "frameworks": [
        "IFRS",
        "US_GAAP",
        "UK_GAAP",
        "AASB"
      ],
      "claim_ids": [
        "TOPIC-03-003-IFRS-R012",
        "TOPIC-03-003-US-R012",
        "TOPIC-03-003-UK-R012",
        "TOPIC-03-003-AASB-R012"
      ],
      "facts": {
        "old_revenue": 600,
        "new_price": 1400,
        "cost_to_date": 400,
        "new_total_cost": 1000,
        "remaining_distinct": false
      },
      "calculations": {
        "new_cumulative": "new_price*cost_to_date/new_total_cost",
        "reversal": "old_revenue-new_cumulative"
      },
      "expected_calculations": {
        "new_cumulative": 560,
        "reversal": 40
      },
      "route": "remaining_distinct",
      "expected_route": false,
      "opening_balances": {
        "revenue": -600,
        "contract_asset": 600
      },
      "journals": [
        {
          "event": "approved integrated change",
          "lines": [
            {
              "side": "Dr",
              "account": "revenue",
              "amount": "reversal"
            },
            {
              "side": "Cr",
              "account": "contract_asset",
              "amount": "reversal"
            }
          ]
        }
      ],
      "expected_balances": {
        "revenue": -560,
        "contract_asset": 560
      },
      "workpaper_outcome": "Amendment and engineer memo demonstrate one integrated output; price1400 and revised completion cost1000 are approved together.",
      "control_outcome": "Modification-review control rejects prospective-only treatment that leaves accumulated revenue600; bridge decrease40.",
      "data_outcome": "Keep approved amendment linked to original obligation; recompute cumulative revenue without rewriting historical journals.",
      "presentation_disclosure_outcome": "Explain significant modification estimate/timing effect40; updated remaining output remains in obligation note."
    },
    {
