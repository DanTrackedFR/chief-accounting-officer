{
  "cases": [
    {
      "id": "RT-no-enforceable-profit-right",
      "frameworks": [
        "IFRS",
        "US_GAAP",
        "UK_GAAP",
        "AASB"
      ],
      "claim_ids": [
        "TOPIC-03-003-IFRS-R002",
        "TOPIC-03-003-US-R002",
        "TOPIC-03-003-UK-R002",
        "TOPIC-03-003-AASB-R002"
      ],
      "facts": {
        "price": 1000,
        "cost": 300,
        "total_cost": 600,
        "alternative_use": false,
        "termination_payment": 100,
        "required_compensation": 550,
        "customer_controls": false,
        "simultaneous_benefit": false
      },
      "calculations": {
        "potential_progress": "cost/total_cost",
        "revenue": "price*potential_progress if (customer_controls or simultaneous_benefit or (not alternative_use and termination_payment>=required_compensation)) else 0"
      },
      "expected_calculations": {
        "potential_progress": 0.5,
        "revenue": 0
      },
      "route": "customer_controls or simultaneous_benefit or (not alternative_use and termination_payment>=required_compensation)",
      "expected_route": false,
      "opening_balances": {},
      "journals": [
        {
          "event": "custom item remains controlled by seller",
          "lines": [
            {
              "side": "Dr",
              "account": "inventory_wip",
              "amount": "cost"
            },
            {
              "side": "Cr",
              "account": "cash",
              "amount": "cost"
            }
          ]
        }
      ],
      "expected_balances": {
        "inventory_wip": 300,
        "cash": -300
      },
      "workpaper_outcome": "Legal counsel shows cancellation reimbursement100 does not pay cost plus reasonable profit; absence of alternative use alone fails overtime.",
      "control_outcome": "Close reviewer rejects premature revenue500 and confirms WIP ownership/cost recoverability; litigation interpretation retained.",
      "data_outcome": "Timing_rule=point_in_time; no progress revenue event; WIP tracked by job and acceptance controls.",
      "presentation_disclosure_outcome": "No revenue/contract asset; classify WIP under inventory; disclose material timing judgment where required."
    },
