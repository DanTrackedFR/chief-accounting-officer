      "control_outcome": "Activation-date evidence is required in both cases; licence classifier challenge causes120 versus10 revenue, exposing110 premature release if access is miscoded.",
      "data_outcome": "IP type and activity-dependency fields select point-in-time event or12-month access schedule; source licence retained and hosting not silently bundled.",
      "presentation_disclosure_outcome": "Distinguish point-in-time licence120 from over-time access10 and liability110; remaining-term and significant judgment note selects framework relief separately.",
      "framework_routes": {
        "IFRS": {
          "expression": "ongoing_activities_significant and customer_exposed and not separate_activity_transfer",
          "expected": false
        },
        "AASB": {
          "expression": "ongoing_activities_significant and customer_exposed and not separate_activity_transfer",
          "expected": false
        },
        "US_GAAP": {
          "expression": "symbolic or (function_changed and required_updated_use)",
          "expected": false
        },
        "UK_GAAP": {
          "expression": "uk_standready",
          "expected": false
        }
      },
      "control_checks": {
        "licence_activation": {
          "expression": "usable",
          "expected": true
        },
        "premature_full_release_detected": {
          "expression": "access and revenue==price",
          "expected": false
        }
      }
