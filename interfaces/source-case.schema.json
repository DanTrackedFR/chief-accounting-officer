{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trackedfr:cao:source-case:1.2",
  "title": "Bounded source accounting Case, Profile 1.2",
  "type": "object",
  "required": [
    "case_id",
    "framework",
    "jurisdiction",
    "entity",
    "entity_type",
    "period_start",
    "reporting_period",
    "functional_currency",
    "assumptions",
    "source",
    "source_attestation"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "policy_elections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depreciation_convention": {
          "enum": [
            "monthly",
            "actual_days"
          ]
        },
        "partial_month_treatment": {
          "enum": [
            "actual_days_in_month"
          ]
        }
      },
      "default": {},
      "description": "Fixed assets only. Missing convention preserves actual_days. Monthly recommended for new monthly-close configurations; partial months require explicit treatment."
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "version",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_attestation": {
      "type": "object",
      "required": [
        "authenticated_user_reference",
        "timestamp",
        "statement_version",
        "represents_company_records"
      ],
      "properties": {
        "authenticated_user_reference": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "statement_version": {
          "type": "string",
          "minLength": 1
        },
        "represents_company_records": {
          "const": true
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "remaining_life": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Legacy remaining useful life in YEARS at period start or availability; never silently reinterpreted. Must be positive for calculation."
          },
          "remaining_life_months": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Remaining useful life in MONTHS at period start or availability; exact decimal arithmetic. Must be positive. If both fields supplied, remaining_life \u00d712 must equal remaining_life_months."
          },
          "residual": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Explicit residual amount; no replacement assumption is inferred."
          },
          "remaining_life_unit": {
            "const": "years",
            "description": "Optional explicit confirmation of legacy field units. To supply months use remaining_life_months."
          },
          "supplied_net_book_value": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Optional comparison only; never an accounting override. Requires comparison_balance_basis."
          },
          "supplied_accumulated_depreciation": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Optional comparison only; never an accounting override. Requires comparison_balance_basis."
          },
          "comparison_balance_basis": {
            "enum": [
              "opening",
              "closing"
            ],
            "description": "Opening at period_start before movements/charge, or closing at reporting_period after charge and disposal."
          }
        }
      }
    },
    "costs": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "cip": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "invoices": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "accruals": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "payments": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "supplier_balances": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "entity": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "jurisdiction": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "framework": {
      "enum": [
        "IFRS",
        "US_GAAP",
        "UK_GAAP",
        "AASB"
      ]
    },
    "period_start": {
      "type": "string",
      "format": "date",
      "description": "Required Case scope; Profile1.2 currently supports periods wholly within 2026."
    },
    "reporting_period": {
      "type": "string",
      "format": "date",
      "description": "Required Case scope; Profile1.2 currently supports periods wholly within 2026."
    },
    "functional_currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "not": {
        "const": "XXX"
      }
    },
    "class_assumptions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "remaining_life": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Legacy remaining useful life in YEARS at period start or availability; never silently reinterpreted. Must be positive for calculation."
          },
          "remaining_life_months": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Remaining useful life in MONTHS at period start or availability; exact decimal arithmetic. Must be positive. If both fields supplied, remaining_life \u00d712 must equal remaining_life_months."
          },
          "residual": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
              },
              {
                "type": "integer"
              }
            ],
            "description": "Explicit residual amount; no replacement assumption is inferred."
          },
          "remaining_life_unit": {
            "const": "years",
            "description": "Optional explicit confirmation of legacy field units. To supply months use remaining_life_months."
          }
        }
      }
    },
    "asset_policy": {
      "type": "object",
      "properties": {
        "depreciation_convention": {
          "enum": [
            "monthly",
            "actual_days"
          ]
        },
        "partial_month_treatment": {
          "enum": [
            "actual_days_in_month"
          ]
        },
        "confirmation": {
          "const": "confirmed"
        },
        "entity": {
          "type": "string"
        },
        "framework": {
          "enum": [
            "IFRS",
            "US_GAAP",
            "UK_GAAP",
            "AASB"
          ]
        },
        "effective_from": {
          "type": "string",
          "format": "date"
        },
        "effective_to": {
          "type": "string",
          "format": "date"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "description": "A supplied convention must be explicitly confirmed and exactly applicable. Client policy assertion, not independent certification. Conflicting Case election blocks. Native company memory is context-only; explicitly confirm and resubmit candidate policies here."
    }
  },
  "description": "Profile 1.2 permits at most 200 rows across all populations combined (runtime enforced). Oversized source display references use a stable SHA-256-derived reference while native lineage retains the original."
}
