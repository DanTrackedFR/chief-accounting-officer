{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trackedfr:cao:source-case:1.2",
  "title": "Bounded source accounting Case, Profile 1.2",
  "type": "object",
  "required": [
    "case_id",
    "framework",
    "jurisdiction",
    "entity",
    "entity_type",
    "period_start",
    "reporting_period",
    "functional_currency",
    "assumptions",
    "source",
    "source_attestation"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "policy_elections": {
      "type": "object",
      "maxProperties": 0,
      "default": {}
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "version",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "source_attestation": {
      "type": "object",
      "required": [
        "authenticated_user_reference",
        "timestamp",
        "statement_version",
        "represents_company_records"
      ],
      "properties": {
        "authenticated_user_reference": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "statement_version": {
          "type": "string",
          "minLength": 1
        },
        "represents_company_records": {
          "const": true
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "costs": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "cip": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "invoices": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "accruals": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "payments": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    },
    "supplier_balances": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      }
    }
  },
  "description": "Profile 1.2 permits at most 200 rows across all populations combined (runtime enforced). Oversized source display references use a stable SHA-256-derived reference while native lineage retains the original."
}
