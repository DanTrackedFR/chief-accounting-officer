{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAO curated public accounting record",
  "description": "Closed field allowlist. Content must additionally pass interfaces/public_output.py for every public route; schema alone does not sanitize text.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "topic_id": {
      "type": "string"
    },
    "guidance": {
      "type": "string"
    },
    "framework": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "entity_scope": {
      "type": "string"
    },
    "effective_period": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string"
    },
    "confidence": {
      "type": "string"
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reporting": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          }
        }
      }
    },
    "journals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "side": {
                  "type": "string"
                },
                "account": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "accounting_determination": {
      "enum": [
        "SUPPORTED",
        "UNRESOLVED",
        "UNSUPPORTED"
      ]
    },
    "evidence_sufficiency": {
      "enum": [
        "SUFFICIENT",
        "INSUFFICIENT"
      ]
    },
    "review_provenance": {
      "enum": [
        "SYSTEM_PREPARED",
        "FORMALLY_REVIEWED"
      ]
    },
    "source_provenance": {
      "const": "USER_PROVIDED_SOURCES"
    },
    "validation_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "field_path",
          "explanation",
          "category"
        ],
        "properties": {
          "identifier": {
            "type": "string"
          },
          "field_path": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        }
      }
    },
    "anomaly_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "presumed_user_provided"
        },
        "population_status": {
          "enum": [
            "UNRECONCILED",
            "SUPPLIED_FILE_BOUNDED"
          ]
        },
        "completeness": {
          "const": "PRESUMED_FROM_SUPPLIED_FILE_NOT_INDEPENDENTLY_VERIFIED"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "severity",
              "source_reference",
              "row_references",
              "explanation",
              "blocks_calculation",
              "resolution"
            ],
            "properties": {
              "check_id": {
                "type": "string"
              },
              "source_reference": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "field_path": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "PASS",
                  "WARNING",
                  "BLOCKED",
                  "NOT_PERFORMED"
                ]
              },
              "row_references": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "blocks_calculation": {
                "type": "boolean"
              }
            }
          }
        },
        "excluded_rows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "proposed_journals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "journal_reference",
          "case_reference",
          "row_reference",
          "asset_or_transaction_reference",
          "currency",
          "period_start",
          "reporting_period",
          "source_reference",
          "accounting_determination",
          "qualification_status",
          "lines"
        ],
        "properties": {
          "journal_reference": {
            "type": "string"
          },
          "case_reference": {
            "type": "string"
          },
          "row_reference": {
            "type": "string"
          },
          "asset_or_transaction_reference": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "period_start": {
            "type": "string"
          },
          "reporting_period": {
            "type": "string"
          },
          "source_reference": {
            "type": "string"
          },
          "accounting_determination": {
            "const": "SUPPORTED"
          },
          "qualification_status": {
            "const": "PROPOSED"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "account",
                "side",
                "amount"
              ],
              "properties": {
                "account": {
                  "type": "string"
                },
                "side": {
                  "enum": [
                    "Dr",
                    "Cr"
                  ]
                },
                "amount": {
                  "type": "string",
                  "pattern": "^[0-9]+(?:\\.[0-9]+)?$",
                  "description": "Exact numeric decimal string. Parse with decimal arithmetic, not binary float."
                }
              }
            }
          }
        }
      },
      "description": "Proposals only, from native workpaper. Balanced lines; no posting authorization. Case references are curated durable identifiers on hosted routes."
    },
    "applied_assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_reference",
          "field",
          "value",
          "provenance"
        ],
        "properties": {
          "row_reference": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "provenance": {
            "enum": [
              "explicit_user_input",
              "client_asserted_class_assumption",
              "case_election",
              "engine_default_unconfirmed",
              "confirmed_company_policy_client_asserted",
              "explicit_field_semantics",
              "governed_method"
            ]
          }
        }
      }
    },
    "balance_comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "row_reference",
          "asset_reference",
          "source_field_path",
          "explanation",
          "status",
          "balance_basis",
          "supplied_value",
          "calculated_value",
          "variance"
        ],
        "properties": {
          "row_reference": {
            "type": "string"
          },
          "asset_reference": {
            "type": "string"
          },
          "source_field_path": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "status": {
            "enum": [
              "MATCH",
              "MISMATCH",
              "INVALID",
              "UNRESOLVED_BASIS"
            ]
          },
          "balance_basis": {
            "enum": [
              null,
              "opening",
              "closing"
            ]
          },
          "supplied_value": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
          },
          "calculated_value": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
          },
          "variance": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"
          }
        }
      },
      "description": "Variance = supplied minus calculated. Null calculation/variance means comparison could not be performed; no invented balance."
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "proposed_journals"
            ]
          },
          {
            "required": [
              "applied_assumptions"
            ]
          },
          {
            "required": [
              "balance_comparisons"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "source_provenance"
        ],
        "properties": {
          "source_provenance": {
            "const": "USER_PROVIDED_SOURCES"
          }
        }
      }
    }
  ]
}
