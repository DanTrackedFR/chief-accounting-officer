{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CAO curated public accounting record",
  "description": "Closed field allowlist. Content must additionally pass interfaces/public_output.py for every public route; schema alone does not sanitize text.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "topic_id": {
      "type": "string"
    },
    "guidance": {
      "type": "string"
    },
    "framework": {
      "type": "string"
    },
    "jurisdiction": {
      "type": "string"
    },
    "entity_scope": {
      "type": "string"
    },
    "effective_period": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string"
    },
    "confidence": {
      "type": "string"
    },
    "open_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reporting": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calculations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "string"
          }
        }
      }
    },
    "journals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "side": {
                  "type": "string"
                },
                "account": {
                  "type": "string"
                },
                "amount": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "accounting_determination": {
      "enum": [
        "SUPPORTED",
        "UNRESOLVED",
        "UNSUPPORTED"
      ]
    },
    "evidence_sufficiency": {
      "enum": [
        "SUFFICIENT",
        "INSUFFICIENT"
      ]
    },
    "review_provenance": {
      "enum": [
        "SYSTEM_PREPARED",
        "FORMALLY_REVIEWED"
      ]
    },
    "source_provenance": {
      "const": "USER_PROVIDED_SOURCES"
    },
    "validation_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identifier",
          "field_path",
          "explanation",
          "category"
        ],
        "properties": {
          "identifier": {
            "type": "string"
          },
          "field_path": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        }
      }
    },
    "anomaly_report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "presumed_user_provided"
        },
        "population_status": {
          "enum": [
            "UNRECONCILED",
            "SUPPLIED_FILE_BOUNDED"
          ]
        },
        "completeness": {
          "const": "PRESUMED_FROM_SUPPLIED_FILE_NOT_INDEPENDENTLY_VERIFIED"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "severity",
              "source_reference",
              "row_references",
              "explanation",
              "blocks_calculation",
              "resolution"
            ],
            "properties": {
              "check_id": {
                "type": "string"
              },
              "source_reference": {
                "type": "string"
              },
              "explanation": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              },
              "observed": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "field_path": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "PASS",
                  "WARNING",
                  "BLOCKED",
                  "NOT_PERFORMED"
                ]
              },
              "row_references": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "blocks_calculation": {
                "type": "boolean"
              }
            }
          }
        },
        "excluded_rows": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
