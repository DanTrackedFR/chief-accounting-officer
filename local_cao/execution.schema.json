{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trackedfr:cao:execution:1.0",
  "title": "CAO Execution Request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation",
    "company_id"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "operation": {
      "enum": [
        "initialize",
        "diagnose",
        "context",
        "capabilities",
        "start",
        "status",
        "questions",
        "submit",
        "execute",
        "result",
        "resume",
        "list",
        "investigate",
        "document",
        "continue_investigation",
        "investigation",
        "correct_investigation",
        "rework_investigation"
      ]
    },
    "company_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "target_family": {
      "type": "string"
    },
    "evidence": {
      "type": "object"
    },
    "evidence_file": {
      "type": "string"
    },
    "route": {
      "enum": [
        "answer_context",
        "answer",
        "retrieval_snippet",
        "citation",
        "tool_output",
        "user_log",
        "export"
      ]
    },
    "context": {
      "type": "object"
    },
    "interpretation": {
      "type": "object"
    },
    "document": {
      "type": "object"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "node_id": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "start"
          }
        }
      },
      "then": {
        "required": [
          "request_id",
          "objective",
          "target_family"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "status",
              "questions",
              "submit",
              "execute",
              "result",
              "resume"
            ]
          }
        }
      },
      "then": {
        "required": [
          "case_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "submit"
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "evidence"
            ],
            "not": {
              "required": [
                "evidence_file"
              ]
            }
          },
          {
            "required": [
              "evidence_file"
            ],
            "not": {
              "required": [
                "evidence"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "investigate"
          }
        }
      },
      "then": {
        "required": [
          "objective",
          "request_id"
        ],
        "propertyNames": {
          "enum": [
            "company_id",
            "context",
            "contract_version",
            "interpretation",
            "objective",
            "operation",
            "request_id",
            "route",
            "target_family"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "document"
          }
        }
      },
      "then": {
        "required": [
          "case_id",
          "document",
          "event_id"
        ],
        "propertyNames": {
          "enum": [
            "case_id",
            "company_id",
            "contract_version",
            "document",
            "event_id",
            "interpretation",
            "operation",
            "route"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "continue_investigation"
          }
        }
      },
      "then": {
        "required": [
          "case_id",
          "event_id"
        ],
        "propertyNames": {
          "enum": [
            "case_id",
            "company_id",
            "contract_version",
            "event_id",
            "interpretation",
            "operation",
            "route"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "investigation"
          }
        }
      },
      "then": {
        "required": [
          "case_id"
        ],
        "propertyNames": {
          "enum": [
            "case_id",
            "company_id",
            "contract_version",
            "operation",
            "route"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "correct_investigation"
          }
        }
      },
      "then": {
        "required": [
          "case_id",
          "event_id",
          "evidence",
          "node_id",
          "reason"
        ],
        "propertyNames": {
          "enum": [
            "case_id",
            "company_id",
            "contract_version",
            "event_id",
            "evidence",
            "node_id",
            "operation",
            "reason",
            "route"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "rework_investigation"
          }
        }
      },
      "then": {
        "required": [
          "case_id",
          "event_id",
          "evidence"
        ],
        "propertyNames": {
          "enum": [
            "case_id",
            "company_id",
            "contract_version",
            "event_id",
            "evidence",
            "operation",
            "route"
          ]
        }
      }
    }
  ]
}
