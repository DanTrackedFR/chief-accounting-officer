{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:trackedfr:cao:execution:1.0",
  "title": "CAO Execution Request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "operation", "company_id"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "operation": {"enum": ["initialize", "diagnose", "context", "capabilities", "start", "status", "questions", "submit", "execute", "result", "resume", "list"]},
    "company_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"},
    "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,119}$"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 4000},
    "target_family": {"type": "string"},
    "evidence": {"type": "object"},
    "evidence_file": {"type": "string"},
    "route": {"enum": ["answer_context", "answer", "retrieval_snippet", "citation", "tool_output", "user_log", "export"]}
  },
  "allOf": [
    {"if": {"properties": {"operation": {"const": "start"}}}, "then": {"required": ["request_id", "objective", "target_family"]}},
    {"if": {"properties": {"operation": {"enum": ["status", "questions", "submit", "execute", "result", "resume"]}}}, "then": {"required": ["case_id"]}},
    {"if": {"properties": {"operation": {"const": "submit"}}}, "then": {"oneOf": [{"required": ["evidence"], "not": {"required": ["evidence_file"]}}, {"required": ["evidence_file"], "not": {"required": ["evidence"]}}]}}
  ]
}
